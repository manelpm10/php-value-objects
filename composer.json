{
  "name": "manelpm10/php-value-objects",
  "description": "A PHP library of immutable objects classes.",
  "versin": "3.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Manel Pérez",
      "email": "yo@manelperez.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ramsey/uuid": "^4.9",
    "symfony/intl": "^7.4",
    "lambdish/phunctional": "^2.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "config": {
    "bin-dir": "bin"
  },
  "autoload": {
    "psr-4": {"ValueObjects\\": "src"}
  },
  "autoload-dev": {
    "psr-4": { "ValueObjects\\Tests\\": "tests/" }
  }
}
